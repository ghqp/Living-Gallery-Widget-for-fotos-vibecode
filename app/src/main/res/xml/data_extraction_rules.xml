<?xml version="1.0" encoding="utf-8"?>
<!-- Photos can exceed the backup quota and widget ids do not survive a restore, so only settings are kept. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
